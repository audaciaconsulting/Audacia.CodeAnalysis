<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>This package supports projects operating a minimum version of C# 12 and .NET 8.</Description>
		<RootNamespace>Audacia.CodeAnalysis.Analyzers.AspNetCore</RootNamespace>
	</PropertyGroup>

    <PropertyGroup>
		<PackageId>Audacia.CodeAnalysis.Analyzers.AspNetCore</PackageId>
		<Description>This is a set of custom Roslyn analyzers specifically for AspNet Core projects.</Description>
		<PackageTags>Audacia.CodeAnalysis.Analyzers.AspNetCore, analyzers</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    </ItemGroup>

	<ItemGroup>
		<None Update="tools\*.ps1" CopyToOutputDirectory="Always" Pack="true" PackagePath="" />
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Audacia.CodeAnalysis.Analyzers.Shared\Audacia.CodeAnalysis.Analyzers.Shared.csproj" />
    </ItemGroup>

</Project>
